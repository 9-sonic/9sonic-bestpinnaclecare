# Best Pinnacle Care — environment variables.
#
# Local dev/test: copy this to `.env` (gitignored) — dotenv-rails loads it.
# Production: these are set on the server in /home/<user>/api/.env, loaded by
# the systemd unit (deploy/systemd/bestpinnacle-api.service), NOT from git.
#
# GitHub Actions secrets (SERVER_SSH_KEY/HOST/PORT/USER, FIREWORKS_API_KEY,
# PROJECT_TOKEN) and variables (VITE_API_URL, FIREWORKS_*) are configured in the
# repo settings, not here.

# ── Rails ──────────────────────────────────────────────────────────────
# Local dev reads config/master.key from disk, so this is only needed in prod:
# RAILS_MASTER_KEY=<contents of config/master.key>
# ...or set the secret directly instead of the master key:
# SECRET_KEY_BASE=<64+ hex chars: bin/rails secret>

# ── Database ───────────────────────────────────────────────────────────
# Local dev connects to bestpinnacle_development over the Unix socket as your
# OS user, so nothing is needed here. Production sets ONE of:
# DATABASE_URL=postgres://bestpinnacle:PASSWORD@localhost/bestpinnacle_production
# BESTPINNACLE_DATABASE_PASSWORD=<pg password for the bestpinnacle role>

# ── App URLs / origins (required in prod) ──────────────────────────────
# Reset / invite links route by identity: admin -> office web, carer -> PWA.
ADMIN_URL=http://localhost:5174   # prod: https://admin.bestpinnaclecare.co.uk
CARER_URL=http://localhost:5173   # prod: https://carer.bestpinnaclecare.co.uk
# EXACT origin the carer PWA is served from — WebAuthn/passkeys break if wrong.
# Must match CARER_URL. HTTPS in production (localhost is the only non-TLS exception):
WEBAUTHN_ORIGIN=http://localhost:5173   # prod: https://carer.bestpinnaclecare.co.uk
# CORS: browser origins allowed to call the API (comma-separated). Defaults to
# the admin + carer domains + localhost, so usually unset. Override if needed:
# CORS_ORIGINS=https://admin.bestpinnaclecare.co.uk,https://carer.bestpinnaclecare.co.uk
# Host authorization already allows *.bestpinnaclecare.co.uk; add extra hosts here:
# API_HOSTS=

# ── Auth ───────────────────────────────────────────────────────────────
# Dedicated JWT signing secret (recommended in prod). Falls back to secret_key_base:
# DEVISE_JWT_SECRET_KEY=<bin/rails secret>

# ── Process tuning (optional; sensible defaults) ───────────────────────
# PORT=3000
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=1
# SOLID_QUEUE_IN_PUMA=1
# RAILS_LOG_LEVEL=info

# ── Not yet wired (add when those features land) ───────────────────────
# Email (password reset in prod): SMTP_ADDRESS / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_DOMAIN
# Web push:                        VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
# Geocoding:                       only if switching off keyless Nominatim
