# Single-page app fallback.
#
# The carer app is one HTML file with client-side routing (React Router). When
# someone opens or refreshes a deep link like /home, Apache would look for a
# file called "home", not find it, and 404. This rewrites any path that is not
# a real file or directory to index.html so the router can handle it.
#
# Real assets (js/css/sw.js/images) have a matching file on disk, so the !-f
# check lets them serve normally — including sw.js, which must stay the worker,
# not the app shell.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caching.
#
# index.html and sw.js must never be served stale from the browser's HTTP cache,
# or a returning carer can be pinned to an old shell / an old worker and never
# see a new deploy. (The app is otherwise well-defended: Workbox precaches by
# content hash and lazyWithRetry recovers a missing chunk — this just closes the
# HTTP-cache gap in front of them.) Fingerprinted assets are immutable per hash.
<IfModule mod_headers.c>
  # Fingerprinted assets are immutable per hash — cache hard. Listed FIRST so the
  # no-cache rules below win for the shell files that also end in .js (sw.js),
  # since with overlapping FilesMatch the later block takes precedence.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|ico|wav)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The PWA icons live in public/ with STABLE names (icon-192.png, apple-touch-
  # icon.png, maskable-512.png, favicon.svg…) — not content-hashed. The immutable
  # rule above would pin an old icon on every device for a year, so when the icon
  # artwork changes it never updates (purging the CDN doesn't touch the device
  # cache). Serve these with a short, revalidating cache so a new icon propagates
  # on the next visit. Listed after the immutable block so it wins for these paths.
  <FilesMatch "^(icon.*|maskable-.*|apple-touch-icon.*|android-chrome-.*|favicon.*|mstile-.*|logo)\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Never HTTP-cache the shell or the worker — these must always revalidate so a
  # deploy is seen. This block is last, so it overrides the asset rule for sw.js.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
