# ---------------------------------------------------------------------------
# Frontend environment template. Copy to `.env` for local development:
#   cp .env.example .env
#
# SECURITY: everything here is bundled into the browser JS and is PUBLIC.
# NEVER put secrets here (no Postgres credentials, no JWT signing secret,
# no SMS/API secret keys). Those live ONLY in the Rails backend (/backend).
# Only values safe for the public to see belong in this file.
#
# Vite only exposes variables prefixed with VITE_.
# ---------------------------------------------------------------------------

# Run standalone with in-browser mock data (no backend needed).
# Set to false once the Rails API is ready.
VITE_USE_MOCK=true

# Base URL of the Rails API this PWA talks to (used when VITE_USE_MOCK=false).
VITE_API_BASE_URL=http://localhost:3003/api/v1

# Optional: public/restricted maps key for GPS features (safe to expose only
# if it is domain-restricted in the provider console). Leave blank if unused.
VITE_MAPS_API_KEY=

# App display name (optional; overrides default in UI if set).
VITE_APP_NAME=Best Pinnacle Care
