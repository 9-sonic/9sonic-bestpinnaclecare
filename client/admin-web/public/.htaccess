# Single-page app fallback.
#
# The office console is one HTML file with client-side routing (React Router).
# When someone opens or refreshes a deep link like /team or /board, Apache would
# look for a matching file, not find it, and 404. This rewrites any path that is
# not a real file or directory to index.html so the router can handle it.
#
# Real assets (js/css/images) have a matching file on disk, so the !-f check
# lets them serve normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Caching.
#
# The bug this fixes: index.html was served with no Cache-Control, so browsers
# cached it heuristically. Vite fingerprints its JS/CSS (index-<hash>.js) and a
# deploy deletes the old files, so a stale cached index.html points at chunk
# hashes that no longer exist. When the app lazy-loads a route, that dynamic
# import 404s and the page falls back to a full reload — which looked like the
# sidebar "reloading" on every tab switch after a deploy.
#
# Fix: index.html and the service worker must always be revalidated so a new
# deploy is picked up immediately; the fingerprinted assets never change for a
# given hash, so they can be cached hard.
<IfModule mod_headers.c>
  # Fingerprinted assets are immutable — a new build has a new hash. Listed FIRST
  # so the shell rule below wins for files that also end in .js (sw.js): with
  # overlapping FilesMatch, the later block takes precedence in Apache.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Stable-named icons/logos (not content-hashed) must not be pinned immutably, or
  # a changed favicon/logo never updates on a device for a year. Short revalidating
  # cache instead. Listed after the immutable block so it wins for these paths.
  <FilesMatch "^(icon.*|maskable-.*|apple-touch-icon|favicon|logo)\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Never trust a cached shell or worker — always revalidate. Last, so it
  # overrides the asset rule above for sw.js and keeps it updatable.
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
