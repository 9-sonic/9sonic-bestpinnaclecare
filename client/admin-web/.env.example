# Office web app configuration.
#
# Everything here is bundled into the JavaScript that ships to the browser, so
# it is public. No secrets: the database, JWT signing key and any third party
# API keys live only in the Rails app.

# Base URL of the Rails API. The office app always talks to the real backend.
VITE_API_BASE_URL=http://localhost:3002/api/v1

VITE_APP_NAME=Best Pinnacle Care

# Web Push VAPID public key (safe to expose — it is public by design). Optional:
# if unset, the app fetches it from the API's /admin/push/config at runtime, so
# rotating the key needs no frontend rebuild. Set it here only to pin a value.
VITE_VAPID_PUBLIC_KEY=
